#!/usr/bin/env python3
"""Vault-aware hub helpers. Passwords never printed.

  scripts/hubctl status
  scripts/hubctl static garden|home|both [--replace-unstamped]
  scripts/hubctl backend garden|home|both
  scripts/hubctl reload garden|home

backend uploads source only and does not move static-id.
On first backend copy, the Pi copies its live backend/static into served/
so a later backend copy cannot replace the page.
static builds a fresh page into served/ and stamps static-id only if
the uploaded build-id matches HEAD. It refuses when the live page has no
build-id, unless --replace-unstamped is passed.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STATIC_ID_REMOTE = "/home/simmoe/HUE_EJDERSTED/static-id"
# Sibling of backend/. A copy of backend/ cannot replace the page.
SERVED_REMOTE = "/home/simmoe/HUE_EJDERSTED/served"
BUILD_ID_NAME = "build-id"
_SHA = re.compile(r"^[0-9a-f]{40}$")
VAULT = Path.home() / "Documents/Git/cursor-global-setup/.cursor-local/vault/secrets.payload.json"
HOME_IDENTITY = Path.home() / ".ssh" / "hue_ejdersted_ed25519"
SITES = {
    "home": {
        "lan": "192.168.86.16",
        "adb": "192.168.86.15:5555",
        "url": "https://192.168.86.16:8443",
        "ssh_auth": "password",
    },
    "garden": {
        "lan": "192.168.8.133",
        "ts": "100.111.167.54",
        "adb": "192.168.8.135:5555",
        "url": "https://100.111.167.54:8443",
        "ssh_auth": "key",
    },
}


def _die(msg: str, code: int = 2) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def _vault() -> dict:
    if not VAULT.is_file():
        _die("Vault payload missing. In cursor-global-setup: npm run vault:decrypt")
    return json.loads(VAULT.read_text(encoding="utf-8"))


def _pass(site: str) -> str:
    data = _vault()
    if site == "home":
        return str(data["devices"]["ejderstedHomeHub"]["password"])
    return str(data["devices"]["kolonihavePi"]["password"])


def _lan() -> tuple[str, str]:
    ssid = subprocess.run(
        ["networksetup", "-getairportnetwork", "en0"], capture_output=True, text=True
    ).stdout
    ip = subprocess.run(["ipconfig", "getifaddr", "en0"], capture_output=True, text=True).stdout.strip()
    return ssid, ip


def _host(site: str) -> str:
    _, ip = _lan()
    cfg = SITES[site]
    if site == "home" and ip.startswith("192.168.86."):
        return f"simmoe@{cfg['lan']}"
    if site == "garden" and ip.startswith("192.168.8."):
        return f"simmoe@{cfg['lan']}"
    if site == "garden":
        return f"simmoe@{cfg['ts']}"
    return f"simmoe@{cfg['lan']}"


def _home_identity() -> str | None:
    if HOME_IDENTITY.is_file():
        return str(HOME_IDENTITY)
    return None


def _ssh_cmd(site: str, remote: str) -> list[str]:
    host = _host(site)
    if SITES[site]["ssh_auth"] == "password" and shutil.which("sshpass"):
        return [
            "sshpass",
            "-p",
            _pass(site),
            "ssh",
            "-o",
            "PreferredAuthentications=password",
            "-o",
            "PubkeyAuthentication=no",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-o",
            "ConnectTimeout=8",
            host,
            remote,
        ]
    ident = SITES[site].get("identity") or (_home_identity() if site == "home" else None)
    if SITES[site]["ssh_auth"] == "password" and not ident:
        _die("sshpass missing")
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8"]
    if ident:
        cmd += ["-i", ident, "-o", "IdentitiesOnly=yes"]
    cmd += [host, remote]
    return cmd


def _ssh(site: str, remote: str, *, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(_ssh_cmd(site, remote), check=check)


def _scp(site: str, source: Path, dest: str) -> None:
    host = _host(site)
    remote = f"{host}:{dest}"
    if SITES[site]["ssh_auth"] == "password" and shutil.which("sshpass"):
        cmd = [
            "sshpass",
            "-p",
            _pass(site),
            "scp",
            "-o",
            "PreferredAuthentications=password",
            "-o",
            "PubkeyAuthentication=no",
            "-o",
            "StrictHostKeyChecking=accept-new",
            "-r",
            str(source),
            remote,
        ]
    else:
        ident = SITES[site].get("identity") or (_home_identity() if site == "home" else None)
        if SITES[site]["ssh_auth"] == "password" and not ident:
            _die("sshpass missing")
        cmd = ["scp", "-o", "BatchMode=yes", "-r"]
        if ident:
            cmd += ["-i", ident, "-o", "IdentitiesOnly=yes"]
        cmd += [str(source), remote]
    subprocess.run(cmd, check=True)


def _sudo(site: str, remote: str) -> None:
    nopw = _ssh(site, f"sudo -n {remote}", check=False)
    if nopw.returncode == 0:
        return
    if SITES[site]["ssh_auth"] != "password":
        _die(f"{site}: sudo {remote} failed without a password")
    pw = _pass(site).replace("'", "'\\''")
    _ssh(site, f"echo '{pw}' | sudo -S {remote}")


def _sites(arg: str) -> list[str]:
    if arg == "both":
        return ["home", "garden"]
    if arg in SITES:
        return [arg]
    _die("site must be home, garden or both")


def cmd_status(_: list[str]) -> None:
    ssid, ip = _lan()
    print(f"mac {ssid.strip()} {ip}")
    ctx = ssl_insecure()
    for site, cfg in SITES.items():
        url = cfg["url"]
        if site == "garden" and ip.startswith("192.168.8."):
            url = f"https://{cfg['lan']}:8443"
        health = _http(f"{url}/api/health", ctx)
        kiosk = _http(f"{url}/api/kiosk/status", ctx)
        print(f"{site} {url}")
        print(f"  health {health}")
        print(f"  kiosk  {kiosk}")


def ssl_insecure():
    import ssl

    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def _http(url: str, ctx) -> str:
    try:
        with urllib.request.urlopen(url, context=ctx, timeout=8) as res:
            return res.read().decode()[:800]
    except Exception as exc:
        return f"FAIL {exc}"


def _git(args: list[str], *, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=check)


def _require_published_main() -> str:
    fetch = _git(["fetch", "origin"], check=False)
    if fetch.returncode != 0:
        _die("git fetch origin failed. Not deploying.")
    head = _git(["rev-parse", "HEAD"]).stdout.strip()
    origin = _git(["rev-parse", "origin/main"]).stdout.strip()
    if head != origin:
        _die(
            f"HEAD {head[:12]} is not origin/main {origin[:12]}. "
            "Commit, push, and pull before deploy."
        )
    dirty = _git(["status", "--porcelain"]).stdout.strip()
    if dirty:
        _die("Working tree is dirty. Commit and push before deploy.")
    if not _SHA.match(head):
        _die("HEAD is not a commit sha. Not deploying.")
    return head


def _ssh_text(site: str, remote: str) -> subprocess.CompletedProcess:
    return subprocess.run(_ssh_cmd(site, remote), check=False, capture_output=True, text=True)


def _remote_static_id(site: str) -> str:
    result = _ssh_text(site, f"cat {STATIC_ID_REMOTE} 2>/dev/null || true")
    if result.returncode != 0:
        detail = (result.stderr or "").strip() or str(result.returncode)
        _die(f"{site}: could not read static-id ({detail})")
    return result.stdout.strip()


def promote_live_page(root: Path) -> str:
    """Copy backend/static to served/ if the live page is still in the old place.

    Returns exists, copied, or none. Never writes a fake build-id.
    """
    served = root / "served"
    src = root / "backend" / "static"
    if (served / "index.html").is_file():
        return "exists"
    if not (src / "index.html").is_file():
        return "none"
    if served.exists():
        shutil.rmtree(served)
    shutil.copytree(src, served)
    return "copied"


def unstamped_page_blocks_static(build_id: str, replace_unstamped: bool) -> bool:
    """An unstamped page cannot be replaced unless the caller says so."""
    if _SHA.match(build_id.strip()):
        return False
    return not replace_unstamped


def _static_args(args: list[str]) -> tuple[list[str], bool]:
    flags = {a for a in args if a.startswith("--")}
    positional = [a for a in args if not a.startswith("--")]
    unknown = flags - {"--replace-unstamped"}
    if unknown:
        _die("unknown flag %s" % " ".join(sorted(unknown)))
    if len(positional) != 1:
        _die("hubctl static garden|home|both [--replace-unstamped]")
    return _sites(positional[0]), "--replace-unstamped" in flags


def stage_backend(source: Path, dest: Path) -> None:
    """Copy backend source. The page directory is not part of a backend upload."""
    shutil.copytree(
        source,
        dest,
        ignore=shutil.ignore_patterns("static", "served", "__pycache__", "*.pyc", "var", ".pytest_cache"),
    )
    if (dest / "static").exists() or (dest / "served").exists():
        _die("backend stage contains a page directory. Refusing to upload.")


def stamp_site(index: Path, site: str) -> None:
    """Write which hub this page belongs to into the HTML the kiosk paints first."""
    if site not in {"home", "garden"}:
        _die(f"refusing to stamp site {site!r}")
    if not index.is_file():
        _die("build has no index.html")
    text = index.read_text(encoding="utf-8")
    html_tag = re.compile(r"<html\b[^>]*>", re.I)
    if not html_tag.search(text):
        _die("build index.html has no <html>")
    text = html_tag.sub(f'<html lang="da" data-hue-site="{site}">', text, count=1)
    if f'data-hue-site="{site}"' not in text:
        _die("site stamp missing from index.html")
    index.write_text(text, encoding="utf-8")


def stamp_build(static_dir: Path, sha: str) -> None:
    """Write the commit into the build that is about to be uploaded. No other tree."""
    if not _SHA.match(sha):
        _die(f"refusing to stamp a build with {sha!r}")
    index = static_dir / "index.html"
    if not index.is_file():
        _die("build has no index.html")
    text = index.read_text(encoding="utf-8")
    meta = f'<meta name="hue-build" content="{sha}" />'
    if 'name="hue-build"' in text:
        text = re.sub(r'<meta name="hue-build" content="[0-9a-f]{40}"\s*/>', meta, text)
    elif "<head>" not in text:
        _die("build index.html has no <head>")
    else:
        text = text.replace("<head>", "<head>\n\t\t" + meta, 1)
    index.write_text(text, encoding="utf-8")
    (static_dir / BUILD_ID_NAME).write_text(sha + "\n", encoding="utf-8")


def page_commit_to_guard(build_id: str, static_id: str) -> str:
    """The commit baked into the page wins over the stamp file."""
    build_id = build_id.strip()
    static_id = static_id.strip()
    if _SHA.match(build_id):
        return build_id
    return static_id


def _require_hub_ancestor(site: str, head: str, *, replace_unstamped: bool | None = None) -> None:
    build_id = _ssh_text(site, f"cat {SERVED_REMOTE}/{BUILD_ID_NAME} 2>/dev/null || true").stdout
    if not _SHA.match(build_id.strip()):
        legacy = _ssh_text(
            site, f"cat /home/simmoe/HUE_EJDERSTED/backend/static/{BUILD_ID_NAME} 2>/dev/null || true"
        ).stdout
        build_id = legacy
    if replace_unstamped is not None and unstamped_page_blocks_static(build_id, replace_unstamped):
        _die(
            f"{site} has no baked build-id. Refusing to replace an unstamped page. "
            "Pass --replace-unstamped when this commit should become the page."
        )
    current = page_commit_to_guard(build_id, _remote_static_id(site))
    if not current:
        print(f"{site} has no static-id. This deploy records {head[:12]}.")
        return
    if not _SHA.match(current):
        _die(f"{site} static-id is not a commit sha. Refusing to overwrite.")
    if _git(["cat-file", "-t", current], check=False).returncode != 0:
        _die(f"{site} is on {current[:12]}, which is not in this repo. Fetch before deploy.")
    if _git(["merge-base", "--is-ancestor", current, head], check=False).returncode != 0:
        _die(
            f"{site} is on {current[:12]}, which is not contained in {head[:12]}. "
            "Merge that work into main before deploy."
        )


def _guard_deploy(sites: list[str], *, replace_unstamped: bool | None = None) -> str:
    head = _require_published_main()
    for site in sites:
        _require_hub_ancestor(site, head, replace_unstamped=replace_unstamped)
    return head


def _promote_remote(site: str) -> str:
    script = """set -eu
base=/home/simmoe/HUE_EJDERSTED
if [ -f "$base/served/index.html" ]; then
  echo served:exists
  exit 0
fi
if [ ! -f "$base/backend/static/index.html" ]; then
  echo served:none
  exit 0
fi
rm -rf "$base/served"
cp -a "$base/backend/static" "$base/served"
echo served:copied
"""
    result = _ssh_text(site, script)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() or str(result.returncode)
        _die(f"{site}: could not move the live page aside ({detail})")
    text = (result.stdout or "").strip()
    if "served:" not in text:
        _die(f"{site}: live page move returned {text!r}")
    return text


def _build_page(head: str) -> Path:
    """Build the frontend into a new directory. Never reads backend/static."""
    if not shutil.which("npm"):
        _die("npm missing. Not building the page.")
    parent = Path(tempfile.mkdtemp(prefix="hue-static-"))
    out = parent / "served"
    out.mkdir()
    env = os.environ.copy()
    env["HUE_STATIC_OUT"] = str(out)
    print(f"→ build {head[:12]} → {out}")
    subprocess.run(["npm", "run", "build"], cwd=ROOT / "frontend", env=env, check=True)
    stamp_build(out, head)
    baked = (out / BUILD_ID_NAME).read_text(encoding="utf-8").strip()
    if baked != head or f'content="{head}"' not in (out / "index.html").read_text(encoding="utf-8"):
        _die("build stamp does not match HEAD. Not uploading.")
    return out


def _install_page(site: str, archive: Path, head: str) -> bool:
    """Swap served/ only after the uploaded build-id matches HEAD.

    Returns whether a page was already being served from served/.
    static-id is written in the same remote step, after the check.
    """
    remote_tar = f"/tmp/hue-served-{head}.tgz"
    _scp(site, archive, remote_tar)
    script = f"""set -eu
base=/home/simmoe/HUE_EJDERSTED
rm -rf "$base/served.new"
mkdir -p "$base/served.new"
tar -xzf {remote_tar} -C "$base/served.new"
baked=$(tr -d '[:space:]' < "$base/served.new/build-id")
if [ "$baked" != {head} ]; then
  rm -rf "$base/served.new"
  echo "mismatch" >&2
  exit 1
fi
had=0
if [ -f "$base/served/index.html" ]; then had=1; fi
rm -rf "$base/served.prev"
if [ -d "$base/served" ]; then mv "$base/served" "$base/served.prev"; fi
mv "$base/served.new" "$base/served"
rm -rf "$base/served.prev"
printf '%s\\n' {head} > "$base/static-id"
rm -f {remote_tar}
echo "had:$had"
"""
    result = _ssh_text(site, script)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() or str(result.returncode)
        _die(f"{site}: page was not swapped ({detail}). static-id was not moved.")
    return "had:1" in result.stdout


def cmd_static(args: list[str]) -> None:
    if not args:
        _die("hubctl static garden|home|both [--replace-unstamped]")
    sites, replace_unstamped = _static_args(args)
    head = _guard_deploy(sites, replace_unstamped=replace_unstamped)
    out = _build_page(head)
    try:
        for site in sites:
            site_dir = out.parent / site
            if site_dir.exists():
                shutil.rmtree(site_dir)
            shutil.copytree(out, site_dir)
            stamp_site(site_dir / "index.html", site)
            archive = out.parent / f"page-{site}.tgz"
            subprocess.run(["tar", "-C", str(site_dir), "-czf", str(archive), "."], check=True)
            print(f"→ static {site} {_host(site)} (fresh build)")
            already = _install_page(site, archive, head)
            if not already:
                _sudo(site, "systemctl restart hue")
                print(f"✓ static {site} {head[:12]} (first served/, hue restart)")
            else:
                print(f"✓ static {site} {head[:12]}")
    finally:
        shutil.rmtree(out.parent, ignore_errors=True)


def cmd_backend(args: list[str]) -> None:
    if not args:
        _die("hubctl backend garden|home|both")
    sites = _sites(args[0])
    head = _guard_deploy(sites)
    parent = Path(tempfile.mkdtemp(prefix="hue-backend-"))
    stage = parent / "backend"
    try:
        stage_backend(ROOT / "backend", stage)
        for site in sites:
            print(f"→ backend {site} {_host(site)} (source only)")
            _scp(site, stage, "/home/simmoe/HUE_EJDERSTED/")
            moved = _promote_remote(site)
            _sudo(site, "systemctl restart hue")
            if "served:copied" in moved:
                print(f"✓ backend {site} {head[:12]} (hue restart, live page moved to served/)")
            else:
                print(f"✓ backend {site} {head[:12]} (hue restart, page untouched)")
    finally:
        shutil.rmtree(parent, ignore_errors=True)


def cmd_reload(args: list[str]) -> None:
    if not args or args[0] not in SITES:
        _die("hubctl reload home|garden")
    site = args[0]
    kiosk = _http(f"{SITES[site]['url']}/api/kiosk/status", ssl_insecure())
    if '"adb": false' in kiosk or kiosk.startswith("FAIL"):
        print(f"{site} kiosk not on ADB — skip reload")
        print(kiosk)
        raise SystemExit(1)
    adb = SITES[site]["adb"]
    if site == "home":
        subprocess.run(["adb", "connect", adb], check=False, capture_output=True)
        subprocess.run(["adb", "-s", adb, "forward", "--remove", "tcp:9222"], check=False)
        subprocess.run(
            ["adb", "-s", adb, "forward", "tcp:9222", "localabstract:chrome_devtools_remote"],
            check=True,
        )
        _cdp_reload(9222, site)
        return
    remote_adb = (
        f"adb connect {adb} >/dev/null; "
        f"adb -s {adb} forward --remove tcp:9222 >/dev/null 2>&1 || true; "
        f"adb -s {adb} forward tcp:9222 localabstract:chrome_devtools_remote"
    )
    ok = _ssh(site, remote_adb, check=False)
    if ok.returncode != 0:
        print(ok.stderr.decode() if ok.stderr else "adb forward failed")
        raise SystemExit(1)
    tunnel = subprocess.Popen(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-N",
            "-L",
            "9334:127.0.0.1:9222",
            _host(site),
        ]
    )
    try:
        time.sleep(1)
        _cdp_reload(9334, site)
    finally:
        tunnel.terminate()
        tunnel.wait(timeout=3)


def _cdp_reload(port: int, label: str) -> None:
    env = os.environ.copy()
    env["HUBCTL_CDP_PORT"] = str(port)
    env["HUBCTL_CDP_LABEL"] = label
    subprocess.run(
        [
            "node",
            "-e",
            r"""
const port = process.env.HUBCTL_CDP_PORT;
const label = process.env.HUBCTL_CDP_LABEL;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
(async () => {
  let pages = [];
  for (let i = 0; i < 16; i++) {
    try {
      const res = await fetch('http://127.0.0.1:' + port + '/json/list');
      pages = (await res.json()).filter((t) => t.type === 'page');
      if (pages.length) break;
    } catch {}
    await sleep(250);
  }
  if (!pages.length) { console.error(label + ': no Chrome page'); process.exit(1); }
  const keep = pages.find((t) => /8443|hue|ejdersted|kolonihave|192\.168/i.test(t.url || '')) || pages[0];
  let wsUrl = keep.webSocketDebuggerUrl.replace(/:[0-9]+\//, ':' + port + '/');
  console.log(label, 'reload', keep.url);
  const ws = new WebSocket(wsUrl);
  await new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error('timeout')), 8000);
    ws.addEventListener('open', () => {
      ws.send(JSON.stringify({ id: 1, method: 'Page.reload', params: { ignoreCache: true } }));
    });
    ws.addEventListener('message', (ev) => {
      const msg = JSON.parse(ev.data);
      if (msg.id === 1) { clearTimeout(t); ws.close(); resolve(); }
    });
    ws.addEventListener('error', reject);
  });
})();
""",
        ],
        check=True,
        env=env,
    )


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        print(__doc__.strip())
        raise SystemExit(0)
    cmd = sys.argv[1]
    args = sys.argv[2:]
    if cmd == "status":
        cmd_status(args)
    elif cmd == "static":
        cmd_static(args)
    elif cmd == "backend":
        cmd_backend(args)
    elif cmd == "reload":
        cmd_reload(args)
    else:
        _die(f"unknown command {cmd}")


if __name__ == "__main__":
    main()
