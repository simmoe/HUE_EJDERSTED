// p5-diary-ca5f7 ONLY.
// Fetched live 2026-08-30 from projects/p5-diary-ca5f7/releases/cloud.firestore
// ruleset 24677326-ab99-4748-b8da-ff5e3750c64b (createTime 2022-02-22).
// Do not deploy this file to p5-firebase-eebc1 (informatik / chord / min-økonomi).
//
// Assumed data on this project includes the diary app plus Ejdersted:
//   ejdersted/radioPlaylists, player_home, player_garden, security_garden
//   ejdersted/fossibot_garden + fossibot_garden/samples/{yyyyMMddTHHmm}
//   ejdersted/audio_home + audio_garden /events/{id} (hub-written playback log)
// The live catch-all is test-mode until 2027-03-24. Keep it. New matches
// use the same window so other sites on this project stay unchanged.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if
          request.time < timestamp.date(2027, 3, 24);
    }

    match /ejdersted/fossibot_garden {
      allow read, write: if request.time < timestamp.date(2027, 3, 24);
      match /samples/{sampleId} {
        allow read, write: if request.time < timestamp.date(2027, 3, 24);
      }
    }
  }
}
